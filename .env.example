# Copy to .env and adjust as needed. Used by docker-compose.yml and by apps/api locally.

# --- Postgres (db service) ---
POSTGRES_USER=papp
POSTGRES_PASSWORD=papp
POSTGRES_DB=papp
POSTGRES_PORT=5432

# --- apps/api ---
# Full connection string apps/api (Prisma + the raw migration runner) connects with.
# Host is "db" inside docker-compose, "localhost" when running the api outside docker.
DATABASE_URL=postgresql://papp:papp@localhost:5432/papp?schema=public
PORT=3000
# Signs/verifies access tokens (see apps/api/src/core/auth/jwt.constants.ts).
# Required in docker-compose (no default there); apps/api falls back to a
# clearly-labelled insecure dev value if unset when run outside docker, but
# real deployments must set a long random value here.
JWT_SECRET=change-me-to-a-long-random-value

# --- Notification Center email channel (apps/api, Phase 4) ---
# Outbound email goes through an external SMTP relay — no 4th docker-compose
# service (D5). Leave SMTP_HOST unset for local dev: the api then uses a
# dev-capture transport that renders each email and logs it loudly instead
# of delivering it. SMTP_USER/SMTP_PASS are optional (unauthenticated relay
# if omitted); port 465 implies implicit TLS, anything else uses STARTTLS.
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=
#SMTP_PASS=
#SMTP_FROM=papp <no-reply@example.com>

# --- Reverse proxy / client IP (apps/api, Phase 5) ---
# Set this ONLY when apps/api sits behind a reverse proxy (the docker-compose
# `web` nginx service in front of it) so Express derives the real client IP
# from X-Forwarded-For — this is what PublicThrottlerGuard's per-IP limit on
# public write endpoints (e.g. POST /auth/register) actually keys on
# (ARCHITECTURE.md §7.5). Accepts `true`, a hop-count number, or any other
# Express "trust proxy" value (a subnet, "loopback", etc). Leave UNSET for
# direct/dev access (curl/Postman straight to the api container) — trusting
# X-Forwarded-For from an untrusted direct caller would let them spoof their
# IP and dodge the per-IP throttle entirely.
#TRUST_PROXY=1

# --- CORS (apps/api) ---
# Comma-separated allowlist of origins allowed to make credentialed
# (cookie-carrying) requests — e.g. the Vite dev server and, in a real
# deployment, the docker-compose `web` nginx origin. Must be an exact
# origin, never "*" (a wildcard is incompatible with credentials:true —
# browsers reject it). Defaults to http://localhost:5173 when unset.
#WEB_ORIGIN=http://localhost:5173,https://library.example.org

# --- Module system (apps/api, Phase 5) ---
# Overrides where installable module packages are read from (default:
# "<repo root>/modules", see apps/api/src/core/module-registry/modules-dir.ts).
# Used by integration tests / a throwaway fixture module directory.
#MODULES_DIR=/path/to/modules

# --- apps/web ---
WEB_PORT=5173
# Base URL the web app calls the api on.
VITE_API_URL=http://localhost:3000
