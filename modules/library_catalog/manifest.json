{
  "key": "library_catalog",
  "name": "Library Catalog",
  "version": "1.0.0",
  "compatibleAppVersion": ">=0.1.0 <1.0.0",
  "dependsOn": [],
  "description": "Book catalog: titles, physical copies, categories, and a public shareable availability check. D44: stands alone — borrowing/returning/fines are a separate, future library_circulation+library_finance module that will dependsOn this one.",

  "migrations": {
    "dir": "migrations"
  },

  "locales": {
    "supported": ["ar", "en"],
    "dir": "locales"
  },

  "permissions": [
    { "code": "library_catalog.books.view", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.view" },
    { "code": "library_catalog.books.create", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.create" },
    { "code": "library_catalog.books.update", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.update" },
    { "code": "library_catalog.books.delete", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.delete" },
    { "code": "library_catalog.books.export", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.export" },
    { "code": "library_catalog.books.rate", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.rate" },
    { "code": "library_catalog.books.moderate_ratings", "category": "library_catalog", "descriptionKey": "library_catalog.perm.books.moderate_ratings" }
  ],

  "defaultRolePermissions": {
    "admin": [
      "library_catalog.books.view",
      "library_catalog.books.create",
      "library_catalog.books.update",
      "library_catalog.books.delete",
      "library_catalog.books.export",
      "library_catalog.books.rate",
      "library_catalog.books.moderate_ratings"
    ],
    "library_assistant": [
      "library_catalog.books.view",
      "library_catalog.books.create",
      "library_catalog.books.update",
      "library_catalog.books.rate",
      "library_catalog.books.moderate_ratings"
    ],
    "finance": [],
    "reader": ["library_catalog.books.view", "library_catalog.books.rate"]
  },

  "roleAccessPolicy": "grantable",
  "roleAccessLocked": {},

  "settings": [],

  "menu": [
    {
      "id": "library_catalog.root",
      "labelKey": "library_catalog.menu.root",
      "icon": "MenuBook",
      "parentId": null,
      "order": 20,
      "route": "/library/books",
      "requiredPermission": "library_catalog.books.view"
    },
    {
      "id": "library_catalog.books.list",
      "labelKey": "library_catalog.menu.books",
      "parentId": "library_catalog.root",
      "order": 1,
      "route": "/library/books",
      "requiredPermission": "library_catalog.books.view"
    },
    {
      "id": "library_catalog.reviews.moderate",
      "labelKey": "library_catalog.menu.moderate_reviews",
      "parentId": "library_catalog.root",
      "order": 2,
      "route": "/library/reviews/moderate",
      "requiredPermission": "library_catalog.books.moderate_ratings"
    }
  ],

  "routes": [
    {
      "pattern": "/library/books",
      "access": "authenticated",
      "requiredPermission": "library_catalog.books.view",
      "component": "frontend/pages/BooksListPage.tsx"
    },
    {
      "pattern": "/library/books/:bookId",
      "access": "authenticated",
      "requiredPermission": "library_catalog.books.view",
      "component": "frontend/pages/BookDetailPage.tsx"
    },
    {
      "pattern": "/library/public/books/:bookId/availability",
      "access": "public",
      "component": "frontend/pages/PublicBookAvailabilityPage.tsx"
    },
    {
      "pattern": "/library/reviews/moderate",
      "access": "authenticated",
      "requiredPermission": "library_catalog.books.moderate_ratings",
      "component": "frontend/pages/ModerateReviewsPage.tsx"
    }
  ],

  "frontend": {
    "basePath": "/library",
    "entry": "frontend/routes.tsx",
    "landingPage": "/library/books"
  },

  "backend": {
    "entry": "backend/library-catalog.module.js",
    "apiPrefix": "/api/library"
  },

  "lifecycle": {
    "onInstall": null,
    "onUpgrade": null,
    "onUninstall": null
  }
}
