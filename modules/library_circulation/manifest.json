{
  "key": "library_circulation",
  "name": "Library Circulation & Finance",
  "version": "1.0.0",
  "compatibleAppVersion": ">=0.1.0 <1.0.0",
  "dependsOn": ["library_catalog"],
  "description": "Students, staff-performed borrow/return, fines, and the finance side (transactions/payments/receipts) built on top of library_catalog's books/copies (D44). Requirements captured in docs/LIBRARY_MODULE_REQUIREMENTS.md.",

  "migrations": {
    "dir": "migrations"
  },

  "locales": {
    "supported": ["ar", "en"],
    "dir": "locales"
  },

  "permissions": [
    { "code": "library_circulation.students.view", "category": "library_circulation", "descriptionKey": "library_circulation.perm.students.view" },
    { "code": "library_circulation.students.create", "category": "library_circulation", "descriptionKey": "library_circulation.perm.students.create" },
    { "code": "library_circulation.students.update", "category": "library_circulation", "descriptionKey": "library_circulation.perm.students.update" },
    { "code": "library_circulation.students.delete", "category": "library_circulation", "descriptionKey": "library_circulation.perm.students.delete" },
    { "code": "library_circulation.borrow", "category": "library_circulation", "descriptionKey": "library_circulation.perm.borrow" },
    { "code": "library_circulation.return", "category": "library_circulation", "descriptionKey": "library_circulation.perm.return" },
    { "code": "library_circulation.fines.view", "category": "library_circulation", "descriptionKey": "library_circulation.perm.fines.view" },
    { "code": "library_circulation.fines.record", "category": "library_circulation", "descriptionKey": "library_circulation.perm.fines.record" },
    { "code": "library_circulation.fines.waive", "category": "library_circulation", "descriptionKey": "library_circulation.perm.fines.waive" },
    { "code": "library_circulation.fines.update_after_payment", "category": "library_circulation", "descriptionKey": "library_circulation.perm.fines.update_after_payment" },
    { "code": "library_circulation.finance.view", "category": "library_circulation", "descriptionKey": "library_circulation.perm.finance.view" },
    { "code": "library_circulation.finance.record_payment", "category": "library_circulation", "descriptionKey": "library_circulation.perm.finance.record_payment" },
    { "code": "library_circulation.settings.update", "category": "library_circulation", "descriptionKey": "library_circulation.perm.settings.update" },
    { "code": "library_circulation.dashboard.view", "category": "library_circulation", "descriptionKey": "library_circulation.perm.dashboard.view" }
  ],

  "defaultRolePermissions": {
    "admin": [
      "library_circulation.students.view",
      "library_circulation.students.create",
      "library_circulation.students.update",
      "library_circulation.students.delete",
      "library_circulation.borrow",
      "library_circulation.return",
      "library_circulation.fines.view",
      "library_circulation.fines.record",
      "library_circulation.fines.waive",
      "library_circulation.fines.update_after_payment",
      "library_circulation.finance.view",
      "library_circulation.finance.record_payment",
      "library_circulation.settings.update",
      "library_circulation.dashboard.view"
    ],
    "library_assistant": [
      "library_circulation.students.view",
      "library_circulation.students.create",
      "library_circulation.students.update",
      "library_circulation.borrow",
      "library_circulation.return",
      "library_circulation.fines.view",
      "library_circulation.dashboard.view"
    ],
    "finance": [
      "library_circulation.fines.view",
      "library_circulation.finance.view",
      "library_circulation.finance.record_payment",
      "library_circulation.dashboard.view"
    ],
    "reader": []
  },

  "roleAccessPolicy": "grantable",
  "roleAccessLocked": {},

  "settings": [
    {
      "key": "library_circulation.loan_policy",
      "type": "json",
      "default": { "maxBooksPerStudent": 5, "loanPeriodDays": 14, "finePerDay": 1 },
      "labelKey": "library_circulation.settings.loan_policy_label",
      "requiredPermission": "library_circulation.settings.update"
    }
  ],

  "menu": [
    {
      "id": "library_circulation.root",
      "labelKey": "library_circulation.menu.root",
      "icon": "QrCodeScanner",
      "parentId": null,
      "order": 21,
      "route": "/library-circulation/scan",
      "requiredPermission": "library_circulation.borrow"
    },
    {
      "id": "library_circulation.dashboard",
      "labelKey": "library_circulation.menu.dashboard",
      "icon": "Dashboard",
      "parentId": "library_circulation.root",
      "order": 0,
      "route": "/library-circulation/dashboard",
      "requiredPermission": "library_circulation.dashboard.view"
    },
    {
      "id": "library_circulation.scan",
      "labelKey": "library_circulation.menu.scan",
      "icon": "QrCodeScanner",
      "parentId": "library_circulation.root",
      "order": 1,
      "route": "/library-circulation/scan",
      "requiredPermission": "library_circulation.borrow"
    },
    {
      "id": "library_circulation.students",
      "labelKey": "library_circulation.menu.students",
      "icon": "Group",
      "parentId": "library_circulation.root",
      "order": 2,
      "route": "/library-circulation/students",
      "requiredPermission": "library_circulation.students.view"
    },
    {
      "id": "library_circulation.fines",
      "labelKey": "library_circulation.menu.fines",
      "icon": "Paid",
      "parentId": "library_circulation.root",
      "order": 3,
      "route": "/library-circulation/fines",
      "requiredPermission": "library_circulation.fines.view"
    },
    {
      "id": "library_circulation.finance",
      "labelKey": "library_circulation.menu.finance",
      "icon": "Paid",
      "parentId": "library_circulation.root",
      "order": 4,
      "route": "/library-circulation/finance",
      "requiredPermission": "library_circulation.finance.view"
    },
    {
      "id": "library_circulation.settings",
      "labelKey": "library_circulation.menu.settings",
      "icon": "Settings",
      "parentId": "library_circulation.root",
      "order": 5,
      "route": "/library-circulation/settings",
      "requiredPermission": "library_circulation.settings.update"
    }
  ],

  "routes": [
    {
      "pattern": "/library-circulation/dashboard",
      "access": "authenticated",
      "requiredPermission": "library_circulation.dashboard.view",
      "component": "frontend/pages/DashboardPage.tsx"
    },
    {
      "pattern": "/library-circulation/scan",
      "access": "authenticated",
      "requiredPermission": "library_circulation.borrow",
      "component": "frontend/pages/ScanPage.tsx"
    },
    {
      "pattern": "/library-circulation/students",
      "access": "authenticated",
      "requiredPermission": "library_circulation.students.view",
      "component": "frontend/pages/StudentsListPage.tsx"
    },
    {
      "pattern": "/library-circulation/students/:studentId",
      "access": "authenticated",
      "requiredPermission": "library_circulation.students.view",
      "component": "frontend/pages/StudentDetailPage.tsx"
    },
    {
      "pattern": "/library-circulation/fines",
      "access": "authenticated",
      "requiredPermission": "library_circulation.fines.view",
      "component": "frontend/pages/FinesPage.tsx"
    },
    {
      "pattern": "/library-circulation/finance",
      "access": "authenticated",
      "requiredPermission": "library_circulation.finance.view",
      "component": "frontend/pages/FinancePage.tsx"
    },
    {
      "pattern": "/library-circulation/books/:bookId/history",
      "access": "authenticated",
      "requiredPermission": "library_circulation.borrow",
      "component": "frontend/pages/BookHistoryPage.tsx"
    },
    {
      "pattern": "/library-circulation/settings",
      "access": "authenticated",
      "requiredPermission": "library_circulation.settings.update",
      "component": "frontend/pages/SettingsPage.tsx"
    }
  ],

  "frontend": {
    "basePath": "/library-circulation",
    "entry": "frontend/routes.tsx",
    "landingPage": "/library-circulation/scan"
  },

  "backend": {
    "entry": "backend/library-circulation.module.js",
    "apiPrefix": "/api/library-circulation"
  },

  "lifecycle": {
    "onInstall": null,
    "onUpgrade": null,
    "onUninstall": null
  }
}
