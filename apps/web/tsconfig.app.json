{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,

    // `paths: {}` deliberately CANCELS the `@papp/shared-types` -> TS-source
    // mapping inherited from tsconfig.base.json (`extends` replaces `paths`
    // wholesale, it doesn't merge) — same fix, same reason, as
    // apps/api/tsconfig.json's own `paths: {}` (read that file's docblock
    // for the full story). Resolving the alias to `packages/shared-types/
    // src/*.ts` pulls a file outside this `composite: true` project's own
    // `include` list into the program, which `tsc -b` rejects (TS6307:
    // "File is not listed within the file list of project") the moment a
    // second file (module-manifest.ts) is reached transitively. This
    // project must resolve `@papp/shared-types` the normal way instead:
    // real node_modules package resolution against the npm workspace
    // symlink, reading its BUILT `dist/index.d.ts` (per its package.json
    // `types` field) — which also matches what Vite's own bundler resolves
    // at dev/build time, so TS and the real runtime never disagree.
    "paths": {}
  },
  "include": [
    "src",
    "../../modules/*/frontend",
    // The survey module's logic-engine.ts is deliberately framework-free
    // (see its own docblock) specifically so the frontend can import the
    // .ts SOURCE directly instead of duplicating the visibility evaluator —
    // `composite: true` requires every file reachable from `include` to be
    // listed explicitly, so this one file (never a whole `backend/**`
    // glob — everything else there is NestJS/Node-only and would not
    // type-check under this project's DOM-only `lib`) is named here too.
    "../../modules/*/backend/logic-engine.ts"
  ]
}
