// papp — Prisma schema (hand-maintained, mirrors the raw SQL migrations under
// apps/api/src/core/migrations/*.sql — see docs/BUILD_PLAN.md §1/§2 and D16 in
// docs/DECISIONS.md). `prisma generate` only — `prisma migrate` is never run in
// this repo; schema changes ship as a new raw .sql migration file first, and
// this file is updated by hand to match what that SQL actually created.
//
// Phase 0 scope: only the module registry / migration-tracking tables. The
// rest of the core model set (User, Role, Permission, AuditLog, ...) arrives
// phase by phase alongside the migration file that creates it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleStatus {
  installing
  installed
  upgrading
  disabled
  uninstalling
  failed

  @@map("module_status")
}

/// A row per installed "module" — including the core platform itself, tracked
/// as the non-uninstallable pseudo-module `key = "core"` (see BUILD_PLAN.md §1).
model ModuleRegistryEntry {
  key              String       @id
  version          String
  status           ModuleStatus
  installedAt      DateTime?    @map("installed_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  manifestSnapshot Json?        @map("manifest_snapshot")

  @@map("module_registry")
}

/// One row per applied `.sql` migration file, keyed by (moduleKey, filename),
/// checksum-verified by MigrationRunnerService so a shipped migration can
/// never be silently re-applied after being edited.
model ModuleMigration {
  id        String   @id @default(uuid()) @db.Uuid
  moduleKey String   @map("module_key")
  filename  String
  checksum  String
  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([moduleKey, filename])
  @@map("module_migrations")
}

// --- Phase 1: Auth + Sessions + Users core -------------------------------
// See apps/api/src/core/migrations/0001_create_users.sql,
// 0002_create_user_sessions.sql, 0003_create_system_settings.sql for the
// raw DDL this mirrors, and docs/BUILD_PLAN.md §2 for the field outline.
//
// `failedLoginAttempts`/`lockedUntil` on User are additions beyond
// BUILD_PLAN.md §2's literal outline — lockout (auth.password_policy) has
// nowhere else to persist its running state. See 0001_create_users.sql's
// header comment.

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  name                String
  externalId          String?   @unique @map("external_id")
  department          String?
  /// @Sensitive
  passwordHash        String    @map("password_hash")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  /// Route the user is redirected to right after login; null = platform
  /// default. Validated against installed modules' frontend.landingPage
  /// values in UsersService, never trusted as an arbitrary path.
  defaultLandingPage  String?   @map("default_landing_page")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @db.Uuid @map("created_by")

  sessions  UserSession[]
  userRoles UserRole[]

  @@map("users")
}

/// One row per issued refresh token / session (`id` doubles as the JWT `sid`
/// claim). See ARCHITECTURE.md §6.1.
model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  /// @Sensitive
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  geoLocation      Json?     @map("geo_location")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

/// Admin-tunable policy/threshold storage (D22/D23/D24) — password policy,
/// token lifetimes, notification templates, etc. Read through
/// SettingsService, never a hardcoded constant.
model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// --- Phase 2: Roles + Permissions ----------------------------------------
// See apps/api/src/core/migrations/0004_create_roles_permissions.sql for the
// raw DDL + seed data this mirrors, and docs/ARCHITECTURE.md §7.1.

/// The 4 base roles (D9) are seeded with `isSystem = true` and are never
/// deletable. Admins may create additional custom roles later (isSystem = false).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameI18nKey String   @map("name_i18n_key")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// The permission catalog — registered the same conceptual way a module
/// manifest would (code, moduleKey, category, descriptionI18nKey). `core`'s
/// own catalog is seeded by 0004_create_roles_permissions.sql; a future
/// installed module registers its own permissions the same way at install time.
model Permission {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  moduleKey          String   @map("module_key")
  category           String
  descriptionI18nKey String   @map("description_i18n_key")
  createdAt          DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// The grant table admins edit from the Permissions page. A user's effective
/// permission set = union of permissions granted to every role they hold —
/// always resolved fresh from this table by PermissionGuard, never cached
/// across requests and never trusted from a JWT claim (ARCHITECTURE.md §7.2).
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @map("granted_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// --- Phase 3: Audit log ---------------------------------------------------
// See apps/api/src/core/migrations/0005_create_audit_log.sql for the raw DDL
// this mirrors (including the CHECK (actor_type <> 'user' OR actor_user_id
// IS NOT NULL) constraint, which Prisma cannot express), and
// docs/ARCHITECTURE.md §8.1.

enum ActorType {
  user
  system
  anonymous

  @@map("actor_type")
}

/// One row per audited action (D13). `actorUserId`/`actorSessionId` are
/// deliberately NOT relations — audit rows must outlive the user/session
/// they describe, so only the historical UUID is kept. `oldValue`/`newValue`
/// are always passed through the @Sensitive redaction helper
/// (src/common/sensitive/sensitive-fields.ts) before being written.
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  actorUserId    String?   @db.Uuid @map("actor_user_id")
  actorSessionId String?   @db.Uuid @map("actor_session_id")
  actorType      ActorType @map("actor_type")
  category       String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  action         String
  oldValue       Json?     @map("old_value")
  newValue       Json?     @map("new_value")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")

  @@index([occurredAt])
  @@index([category])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

// --- Phase 4: Notification Center ------------------------------------------
// See apps/api/src/core/migrations/0006_create_notifications.sql for the raw
// DDL this mirrors (including the two target-shape CHECK constraints Prisma
// cannot express), and docs/ARCHITECTURE.md §12 / docs/BUILD_PLAN.md §2.

enum NotificationTargetType {
  user
  role
  all_users

  @@map("notification_target_type")
}

/// One row per "send" event (D20/D21). `bodyMarkdown` is Markdown SOURCE —
/// rendered to sanitized HTML at send/display time, never stored
/// pre-rendered (§12.1). `sentBy`/`targetId` are deliberately NOT relations:
/// a sent notification must outlive the sender/role it describes (same
/// rationale as AuditLog's actor columns).
model Notification {
  id           String                 @id @default(uuid()) @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")
  category     String
  title        String
  bodyMarkdown String                 @map("body_markdown")
  /// null = system-generated (e.g. a password reset notice).
  sentBy       String?                @db.Uuid @map("sent_by")
  targetType   NotificationTargetType @map("target_type")
  /// user_id or role_id; null when targetType = 'all_users'.
  targetId     String?                @db.Uuid @map("target_id")

  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([category])
  @@map("notifications")
}

/// The in-app fan-out (§12.1): one row per targeted user per notification —
/// drives the bell icon / unread count. `emailedAt` records the moment the
/// email channel actually handed the rendered mail to the transport (null
/// for in-app-only categories or when the email failed).
model NotificationRecipient {
  notificationId String    @db.Uuid @map("notification_id")
  userId         String    @db.Uuid @map("user_id")
  readAt         DateTime? @map("read_at")
  emailedAt      DateTime? @map("emailed_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

// --- Phase 5: Module registry menu entries -------------------------------
// See apps/api/src/core/migrations/0008_module_menu_entries.sql for the raw
// DDL this mirrors, and docs/MODULE_SPEC.md §2 ("menu") / §4 step 5.

/// One row per manifest `menu` entry (MODULE_SPEC.md §2), persisted at
/// install/upgrade time so the frontend can render the nav tree without
/// re-reading every module's manifest.json on every request. `id` is the
/// manifest entry's own globally-unique string id (e.g.
/// "library_catalog.root"), not a generated UUID. `parentId` is a plain
/// column, not a Prisma relation (self-referential FKs would force
/// parent-before-child insert ordering; cycle-freedom and resolution are
/// already guaranteed by the shared Zod schema's self-consistency checks
/// before any row is written — see packages/shared-types/src/module-manifest.ts).
model ModuleMenuEntry {
  id                 String  @id
  moduleKey          String  @map("module_key")
  labelI18nKey       String  @map("label_i18n_key")
  icon               String?
  parentId           String? @map("parent_id")
  order              Int
  route              String
  requiredPermission String  @map("required_permission")

  @@index([moduleKey])
  @@map("module_menu_entries")
}

// --- Phase 8: library_catalog module (first real installable module) -----
// See modules/library_catalog/migrations/001_create_books_table.sql and
// 002_create_book_copies_table.sql for the raw DDL these mirror, and
// docs/LIBRARY_MODULE_REQUIREMENTS.md §4-5 for the field shape. Per
// BUILD_PLAN.md §2's note, a module-owned table gets its own `model` block
// appended here BY HAND (never `prisma migrate`) after its migration ships,
// `@@map`-ed to the table the raw SQL actually created.

enum LibraryCatalogBookCopyStatus {
  available
  borrowed
  lost
  damaged
  maintenance
  reserved

  @@map("library_catalog_book_copy_status")
}

/// The catalog record (one row per title, independent of how many physical
/// copies exist — see LibraryCatalogBookCopy below).
model LibraryCatalogBook {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  author       String?
  publisher    String?
  category     String?
  readingLevel String?  @map("reading_level")
  language     String?
  description  String?
  coverImage   String?  @map("cover_image")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  copies  LibraryCatalogBookCopy[]
  ratings LibraryCatalogBookRating[]

  @@map("library_catalog_books")
}

/// 1-5 star rating + optional written review, one per (book, user), editable
/// (LIBRARY_CATALOG-D20). `userId` is a plain scalar column, no Prisma
/// relation to the core `User` model — same "cross-module/cross-concern FK
/// without a relation traversal" pattern as every other module's own
/// `createdBy`/`assignedBy`-shaped columns; the rater's display name is
/// joined in the service layer via a separate `prisma.user.findMany` call.
model LibraryCatalogBookRating {
  id        String   @id @default(uuid()) @db.Uuid
  bookId    String   @map("book_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  rating    Int
  review    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  book LibraryCatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, userId])
  @@index([bookId])
  @@map("library_catalog_book_ratings")
}

/// One row per physical, individually-trackable copy of a Book
/// (docs/LIBRARY_MODULE_REQUIREMENTS.md §5). Borrowing history that changes
/// `status` over time belongs to the future library_circulation module
/// (D44) — this table only ever tracks the copy's CURRENT state.
model LibraryCatalogBookCopy {
  id              String                        @id @default(uuid()) @db.Uuid
  bookId          String                        @map("book_id") @db.Uuid
  qrCode          String                        @unique @map("qr_code")
  status          LibraryCatalogBookCopyStatus  @default(available)
  condition       String?
  location        String?
  acquisitionDate DateTime?                     @map("acquisition_date") @db.Date
  createdAt       DateTime                      @default(now()) @map("created_at")
  updatedAt       DateTime                      @updatedAt @map("updated_at")
  history         Json                          @default("[]")

  book LibraryCatalogBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@index([bookId])
  @@index([status])
  @@map("library_catalog_book_copies")
}

// --- survey module ---------------------------------------------------------
// See modules/survey/migrations/001_create_survey_tables.sql for the raw DDL
// these mirror. "One response per respondent" is a per-survey, admin-
// toggleable setting (SurveySurvey.oneResponsePerRespondent), not a DB
// constraint — it's enforced in modules/survey/backend/responses.service.ts,
// not by a unique index (a plain/partial index can't be conditional on
// another table's column).

enum SurveyStatus {
  draft
  published
  closed

  @@map("survey_status")
}

enum SurveyQuestionType {
  short_text
  paragraph
  single_choice
  multi_choice
  dropdown
  linear_scale
  date
  time
  rating

  @@map("survey_question_type")
}

enum SurveyLogicAction {
  show
  hide

  @@map("survey_logic_action")
}

enum SurveyLogicTargetType {
  section
  question

  @@map("survey_logic_target_type")
}

/// The survey definition + its sharing/access settings. `ownerUserId` is the
/// "provider" the completion-notification requirement refers to.
model SurveySurvey {
  id                       String       @id @default(uuid()) @db.Uuid
  title                    String
  description              String?
  status                   SurveyStatus @default(draft)
  ownerUserId              String       @map("owner_user_id") @db.Uuid
  requiresLogin            Boolean      @default(false) @map("requires_login")
  allowEditAfterSubmit     Boolean      @default(false) @map("allow_edit_after_submit")
  oneResponsePerRespondent Boolean      @default(true) @map("one_response_per_respondent")
  notifyOwnerOnSubmit      Boolean      @default(true) @map("notify_owner_on_submit")
  /// Arbitrary admin-typed addresses — the module-owned exception to D21
  /// (docs/DECISIONS.md) — never platform-user targets.
  notifyEmails             Json         @default("[]") @map("notify_emails")
  opensAt                  DateTime?    @map("opens_at")
  closesAt                 DateTime?    @map("closes_at")
  createdAt                DateTime     @default(now()) @map("created_at")
  updatedAt                DateTime     @updatedAt @map("updated_at")

  sections    SurveySection[]
  logicRules  SurveyLogicRule[]
  responses   SurveyResponse[]

  @@index([ownerUserId])
  @@index([status])
  @@map("survey_surveys")
}

model SurveySection {
  id          String  @id @default(uuid()) @db.Uuid
  surveyId    String  @map("survey_id") @db.Uuid
  orderIndex  Int     @map("order_index")
  title       String
  description String?

  survey    SurveySurvey     @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions SurveyQuestion[]

  @@index([surveyId])
  @@map("survey_sections")
}

model SurveyQuestion {
  id          String             @id @default(uuid()) @db.Uuid
  sectionId   String             @map("section_id") @db.Uuid
  orderIndex  Int                @map("order_index")
  type        SurveyQuestionType
  title       String
  description String?
  required    Boolean            @default(false)
  /// Type-specific shape (e.g. linear_scale min/max/labels) — see the
  /// migration's own comment. Never read by raw SQL.
  config      Json               @default("{}")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  section    SurveySection          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  options    SurveyQuestionOption[]
  answers    SurveyAnswer[]
  logicRulesAsSource SurveyLogicRule[] @relation("logicRulesAsSource")

  @@index([sectionId])
  @@map("survey_questions")
}

/// Options for the three enumeration types (single_choice/multi_choice/
/// dropdown) — exactly the "enumeration answers" the logic engine branches on.
model SurveyQuestionOption {
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  orderIndex Int    @map("order_index")
  /// Stable machine value — never renamed once real responses/logic rules
  /// reference it (see the migration's own comment).
  value      String
  label      String

  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, value])
  @@index([questionId])
  @@map("survey_question_options")
}

/// The conditional show/hide engine (docs/DECISIONS.md has the exact
/// visibility semantics). `targetId` is deliberately NOT a relation — it can
/// point at either a SurveySection or a SurveyQuestion depending on
/// `targetType`, which Prisma's relation model can't express as a single FK;
/// resolved and validated in application code (modules/survey/logic-engine.ts
/// + the structure-save endpoint), same rationale as ModuleMenuEntry.parentId
/// above.
model SurveyLogicRule {
  id                 String                @id @default(uuid()) @db.Uuid
  surveyId           String                @map("survey_id") @db.Uuid
  sourceQuestionId   String                @map("source_question_id") @db.Uuid
  sourceOptionValue  String                @map("source_option_value")
  action             SurveyLogicAction
  targetType         SurveyLogicTargetType @map("target_type")
  targetId           String                @map("target_id") @db.Uuid
  orderIndex         Int                   @map("order_index")

  survey         SurveySurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  sourceQuestion SurveyQuestion @relation("logicRulesAsSource", fields: [sourceQuestionId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([sourceQuestionId])
  @@index([targetType, targetId])
  @@map("survey_logic_rules")
}

/// One row per FINAL submission only — see the migration file's header
/// comment for why there is deliberately no draft/partial-response table
/// anywhere in this schema (the user's explicit "not stored in the system
/// unless complete" requirement, satisfied by construction).
model SurveyResponse {
  id                String    @id @default(uuid()) @db.Uuid
  surveyId          String    @map("survey_id") @db.Uuid
  /// Captured whenever the respondent has a real session, regardless of the
  /// survey's own requiresLogin setting (docs/DECISIONS.md).
  respondentUserId  String?   @map("respondent_user_id") @db.Uuid
  respondentEmail   String?   @map("respondent_email")
  /// @Sensitive
  editTokenHash     String?   @map("edit_token_hash")
  submittedAt       DateTime  @default(now()) @map("submitted_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  ipAddress         String?   @map("ip_address")
  userAgent         String?   @map("user_agent")

  survey  SurveySurvey   @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@index([surveyId])
  @@index([respondentUserId])
  @@map("survey_responses")
}

/// One row per question per response — deliberately relational (not one JSON
/// blob per response) specifically so the dynamic pivot report can GROUP BY
/// question_id/value directly in SQL.
model SurveyAnswer {
  id         String @id @default(uuid()) @db.Uuid
  responseId String @map("response_id") @db.Uuid
  questionId String @map("question_id") @db.Uuid
  /// Shape depends on the question's type — string, string[], or number.
  value      Json

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([responseId, questionId])
  @@index([responseId])
  @@index([questionId])
  @@map("survey_answers")
}

// --- template module ---------------------------------------------------
// See modules/template/migrations/001_create_template_items_table.sql for
// the raw DDL this mirrors. The one deliberately simple entity the
// docs/MODULE_SPEC.md §10 scaffold exercises its plumbing on.

enum TemplateItemStatus {
  active
  archived

  @@map("template_item_status")
}

model TemplateItem {
  id          String             @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TemplateItemStatus @default(active)
  ownerUserId String             @map("owner_user_id") @db.Uuid
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  @@index([ownerUserId])
  @@index([status])
  @@map("template_items")
}

// --- library_circulation + library_finance module (D44) --------------------
// See modules/library_circulation/migrations/001_create_library_circulation_tables.sql
// for the raw DDL these mirror, and docs/LIBRARY_MODULE_REQUIREMENTS.md for
// the domain spec. Depends on library_catalog's LibraryCatalogBookCopy.

model LibraryAcademicYear {
  id        String   @id @default(uuid()) @db.Uuid
  label     String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")

  students LibraryStudent[]

  @@map("library_academic_years")
}

/// A "student" is a real platform User with the `reader` role (D41) — this
/// only adds the library-specific fields Users doesn't have.
model LibraryStudent {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  code           String    @unique
  className      String?   @map("class_name")
  academicYearId String?   @map("academic_year_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  academicYear LibraryAcademicYear? @relation(fields: [academicYearId], references: [id])
  borrowings   LibraryBorrowing[]
  fines        LibraryFine[]

  @@index([code])
  @@map("library_students")
}

model LibraryFineType {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique
  name          String
  defaultAmount Decimal @default(0) @map("default_amount") @db.Decimal(10, 2)
  isActive      Boolean @default(true) @map("is_active")

  fines LibraryFine[]

  @@map("library_fine_types")
}

/// Full history is NEVER deleted (§10, "reading passport") — deleting a
/// student/book with history is rejected in the service layer (§22).
model LibraryBorrowing {
  id                  String    @id @default(uuid()) @db.Uuid
  bookCopyId          String    @map("book_copy_id") @db.Uuid
  studentId           String    @map("student_id") @db.Uuid
  status              String    @default("active")
  borrowedAt          DateTime  @default(now()) @map("borrowed_at")
  dueAt               DateTime  @map("due_at")
  returnedAt          DateTime? @map("returned_at")
  borrowedBy          String    @map("borrowed_by") @db.Uuid
  returnedBy          String?   @map("returned_by") @db.Uuid
  comments            String?
  returnStatus        String?   @map("return_status")
  returnNotes         String?   @map("return_notes")
  circulationHistory  Json      @default("[]") @map("circulation_history")

  student LibraryStudent @relation(fields: [studentId], references: [id])
  fines   LibraryFine[]

  @@index([studentId])
  @@index([bookCopyId])
  @@index([status])
  @@map("library_borrowings")
}

model LibraryFine {
  id           String   @id @default(uuid()) @db.Uuid
  fineNumber   String   @unique @map("fine_number")
  studentId    String   @map("student_id") @db.Uuid
  borrowingId  String?  @map("borrowing_id") @db.Uuid
  fineTypeId   String   @map("fine_type_id") @db.Uuid
  status       String   @default("unpaid")
  amount       Decimal  @db.Decimal(10, 2)
  amountPaid   Decimal  @default(0) @map("amount_paid") @db.Decimal(10, 2)
  notes        String?
  createdBy    String   @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  student   LibraryStudent    @relation(fields: [studentId], references: [id])
  borrowing LibraryBorrowing? @relation(fields: [borrowingId], references: [id])
  fineType  LibraryFineType   @relation(fields: [fineTypeId], references: [id])
  transactions LibraryFinancialTransaction[]

  @@index([studentId])
  @@index([status])
  @@map("library_fines")
}

/// Every fine creates exactly one transaction (§12) — the "charge" side of
/// the ledger; LibraryPayment is the "money received" side.
model LibraryFinancialTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  fineId            String   @map("fine_id") @db.Uuid
  transactionNumber String   @unique @map("transaction_number")
  amount            Decimal  @db.Decimal(10, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  fine     LibraryFine       @relation(fields: [fineId], references: [id])
  payments LibraryPayment[]

  @@map("library_financial_transactions")
}

model LibraryPayment {
  id            String   @id @default(uuid()) @db.Uuid
  paymentNumber String   @unique @map("payment_number")
  transactionId String   @map("transaction_id") @db.Uuid
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("cash") @map("payment_method")
  paidAt        DateTime @default(now()) @map("paid_at")
  receivedBy    String   @map("received_by") @db.Uuid

  transaction LibraryFinancialTransaction @relation(fields: [transactionId], references: [id])
  receipt     LibraryReceipt?

  @@map("library_payments")
}

model LibraryReceipt {
  id             String   @id @default(uuid()) @db.Uuid
  paymentId      String   @unique @map("payment_id") @db.Uuid
  receiptNumber  String   @unique @map("receipt_number")
  issuedAt       DateTime @default(now()) @map("issued_at")

  payment LibraryPayment @relation(fields: [paymentId], references: [id])

  @@map("library_receipts")
}

// --- website module ---------------------------------------------------------
// See modules/website/migrations/001_create_website_tables.sql for the raw
// DDL these mirror. No raw-HTML block type exists on purpose — see the
// module's own DOCUMENTATION.md for the rendering-safety design.

model WebsitePage {
  id         String   @id @default(uuid()) @db.Uuid
  slug       String   @unique
  title      String
  status     String   @default("draft")
  isHomepage Boolean  @default(false) @map("is_homepage")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  blocks WebsiteBlock[]

  @@map("website_pages")
}

model WebsiteBlock {
  id         String @id @default(uuid()) @db.Uuid
  pageId     String @map("page_id") @db.Uuid
  orderIndex Int    @map("order_index")
  type       String
  config     Json   @default("{}")

  page WebsitePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, orderIndex])
  @@map("website_blocks")
}

model WebsiteMenuItem {
  id         String  @id @default(uuid()) @db.Uuid
  location   String
  label      String
  urlOrSlug  String  @map("url_or_slug")
  orderIndex Int     @map("order_index")
  parentId   String? @map("parent_id") @db.Uuid

  @@index([location, orderIndex])
  @@map("website_menu_items")
}

// --- reading_club module -----------------------------------------------------
// See modules/reading_club/migrations/001_create_reading_club_tables.sql for
// the raw DDL these mirror. `dependsOn: ["library_circulation"]` — readers
// here are the same `library_students` rows the circulation module's scan
// screen already resolves; that cross-module FK (`studentId`) is a plain
// scalar column with no Prisma relation, same as LibraryBorrowing.bookCopyId
// referencing library_catalog — see modules/reading_club/DECISIONS.md.

model ReadingClubGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by") @db.Uuid

  stages ReadingClubStage[]

  @@map("reading_club_groups")
}

model ReadingClubStage {
  id                String   @id @default(uuid()) @db.Uuid
  groupId           String   @map("group_id") @db.Uuid
  stageOrder        Int      @map("stage_order")
  name              String
  targetType        String   @map("target_type")
  targetAmount      Int      @map("target_amount")
  rewardDescription String?  @map("reward_description")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  group ReadingClubGroup @relation(fields: [groupId], references: [id])

  @@unique([groupId, stageOrder])
  @@index([groupId])
  @@map("reading_club_stages")
}

/// One active membership per reader (studentId is UNIQUE). `stageStartedAt`
/// anchors the live "books returned since entering this stage" progress
/// query; `manualProgressAmount` is the librarian-entered running total,
/// used only for `targetType = 'pages'` stages.
model ReadingClubMembership {
  id                   String   @id @default(uuid()) @db.Uuid
  studentId            String   @unique @map("student_id") @db.Uuid
  groupId              String   @map("group_id") @db.Uuid
  currentStageId       String?  @map("current_stage_id") @db.Uuid
  stageStartedAt       DateTime @default(now()) @map("stage_started_at")
  manualProgressAmount Int      @default(0) @map("manual_progress_amount")
  assignedBy           String   @map("assigned_by") @db.Uuid
  assignedAt           DateTime @default(now()) @map("assigned_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@index([groupId])
  @@index([currentStageId])
  @@map("reading_club_memberships")
}

/// Append-only: one row per "librarian marked this stage finished" event.
/// `rewardStatus` tracks physical reward delivery independently of stage
/// progression — see modules/reading_club/backend/stage-completions.service.ts.
model ReadingClubStageCompletion {
  id                          String    @id @default(uuid()) @db.Uuid
  studentId                   String    @map("student_id") @db.Uuid
  groupId                     String    @map("group_id") @db.Uuid
  stageId                     String    @map("stage_id") @db.Uuid
  targetAmountAtCompletion    Int       @map("target_amount_at_completion")
  progressAmountAtCompletion  Int       @map("progress_amount_at_completion")
  completedAt                 DateTime  @default(now()) @map("completed_at")
  markedBy                    String    @map("marked_by") @db.Uuid
  rewardStatus                String    @default("pending") @map("reward_status")
  rewardDeliveredAt           DateTime? @map("reward_delivered_at")
  rewardDeliveredBy           String?   @map("reward_delivered_by") @db.Uuid
  createdAt                   DateTime  @default(now()) @map("created_at")

  @@index([studentId])
  @@index([rewardStatus])
  @@map("reading_club_stage_completions")
}

/// Many-to-many: a user can hold multiple roles (ARCHITECTURE.md §7.1).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}
