// papp — Prisma schema (hand-maintained, mirrors the raw SQL migrations under
// apps/api/src/core/migrations/*.sql — see docs/BUILD_PLAN.md §1/§2 and D16 in
// docs/DECISIONS.md). `prisma generate` only — `prisma migrate` is never run in
// this repo; schema changes ship as a new raw .sql migration file first, and
// this file is updated by hand to match what that SQL actually created.
//
// Phase 0 scope: only the module registry / migration-tracking tables. The
// rest of the core model set (User, Role, Permission, AuditLog, ...) arrives
// phase by phase alongside the migration file that creates it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ModuleStatus {
  installing
  installed
  upgrading
  disabled
  uninstalling
  failed

  @@map("module_status")
}

/// A row per installed "module" — including the core platform itself, tracked
/// as the non-uninstallable pseudo-module `key = "core"` (see BUILD_PLAN.md §1).
model ModuleRegistryEntry {
  key              String       @id
  version          String
  status           ModuleStatus
  installedAt      DateTime?    @map("installed_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  manifestSnapshot Json?        @map("manifest_snapshot")

  @@map("module_registry")
}

/// One row per applied `.sql` migration file, keyed by (moduleKey, filename),
/// checksum-verified by MigrationRunnerService so a shipped migration can
/// never be silently re-applied after being edited.
model ModuleMigration {
  id        String   @id @default(uuid()) @db.Uuid
  moduleKey String   @map("module_key")
  filename  String
  checksum  String
  appliedAt DateTime @default(now()) @map("applied_at")

  @@unique([moduleKey, filename])
  @@map("module_migrations")
}

// --- Phase 1: Auth + Sessions + Users core -------------------------------
// See apps/api/src/core/migrations/0001_create_users.sql,
// 0002_create_user_sessions.sql, 0003_create_system_settings.sql for the
// raw DDL this mirrors, and docs/BUILD_PLAN.md §2 for the field outline.
//
// `failedLoginAttempts`/`lockedUntil` on User are additions beyond
// BUILD_PLAN.md §2's literal outline — lockout (auth.password_policy) has
// nowhere else to persist its running state. See 0001_create_users.sql's
// header comment.

model User {
  id                  String    @id @default(uuid()) @db.Uuid
  email               String    @unique
  name                String
  externalId          String?   @unique @map("external_id")
  department          String?
  /// @Sensitive
  passwordHash        String    @map("password_hash")
  mustChangePassword  Boolean   @default(false) @map("must_change_password")
  isActive            Boolean   @default(true) @map("is_active")
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @db.Uuid @map("created_by")

  sessions  UserSession[]
  userRoles UserRole[]

  @@map("users")
}

/// One row per issued refresh token / session (`id` doubles as the JWT `sid`
/// claim). See ARCHITECTURE.md §6.1.
model UserSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid @map("user_id")
  /// @Sensitive
  refreshTokenHash String    @unique @map("refresh_token_hash")
  issuedAt         DateTime  @default(now()) @map("issued_at")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  geoLocation      Json?     @map("geo_location")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@map("user_sessions")
}

/// Admin-tunable policy/threshold storage (D22/D23/D24) — password policy,
/// token lifetimes, notification templates, etc. Read through
/// SettingsService, never a hardcoded constant.
model SystemSetting {
  key       String   @id
  value     Json
  updatedBy String?  @db.Uuid @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// --- Phase 2: Roles + Permissions ----------------------------------------
// See apps/api/src/core/migrations/0004_create_roles_permissions.sql for the
// raw DDL + seed data this mirrors, and docs/ARCHITECTURE.md §7.1.

/// The 4 base roles (D9) are seeded with `isSystem = true` and are never
/// deletable. Admins may create additional custom roles later (isSystem = false).
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  nameI18nKey String   @map("name_i18n_key")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

/// The permission catalog — registered the same conceptual way a module
/// manifest would (code, moduleKey, category, descriptionI18nKey). `core`'s
/// own catalog is seeded by 0004_create_roles_permissions.sql; a future
/// installed module registers its own permissions the same way at install time.
model Permission {
  id                 String   @id @default(uuid()) @db.Uuid
  code               String   @unique
  moduleKey          String   @map("module_key")
  category           String
  descriptionI18nKey String   @map("description_i18n_key")
  createdAt          DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

/// The grant table admins edit from the Permissions page. A user's effective
/// permission set = union of permissions granted to every role they hold —
/// always resolved fresh from this table by PermissionGuard, never cached
/// across requests and never trusted from a JWT claim (ARCHITECTURE.md §7.2).
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  grantedAt    DateTime @default(now()) @map("granted_at")
  grantedBy    String?  @map("granted_by") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// --- Phase 3: Audit log ---------------------------------------------------
// See apps/api/src/core/migrations/0005_create_audit_log.sql for the raw DDL
// this mirrors (including the CHECK (actor_type <> 'user' OR actor_user_id
// IS NOT NULL) constraint, which Prisma cannot express), and
// docs/ARCHITECTURE.md §8.1.

enum ActorType {
  user
  system
  anonymous

  @@map("actor_type")
}

/// One row per audited action (D13). `actorUserId`/`actorSessionId` are
/// deliberately NOT relations — audit rows must outlive the user/session
/// they describe, so only the historical UUID is kept. `oldValue`/`newValue`
/// are always passed through the @Sensitive redaction helper
/// (src/common/sensitive/sensitive-fields.ts) before being written.
model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  actorUserId    String?   @db.Uuid @map("actor_user_id")
  actorSessionId String?   @db.Uuid @map("actor_session_id")
  actorType      ActorType @map("actor_type")
  category       String
  entityType     String    @map("entity_type")
  entityId       String?   @map("entity_id")
  action         String
  oldValue       Json?     @map("old_value")
  newValue       Json?     @map("new_value")
  ipAddress      String?   @map("ip_address")
  userAgent      String?   @map("user_agent")

  @@index([occurredAt])
  @@index([category])
  @@index([entityType, entityId])
  @@index([actorUserId])
  @@map("audit_log")
}

// --- Phase 4: Notification Center ------------------------------------------
// See apps/api/src/core/migrations/0006_create_notifications.sql for the raw
// DDL this mirrors (including the two target-shape CHECK constraints Prisma
// cannot express), and docs/ARCHITECTURE.md §12 / docs/BUILD_PLAN.md §2.

enum NotificationTargetType {
  user
  role
  all_users

  @@map("notification_target_type")
}

/// One row per "send" event (D20/D21). `bodyMarkdown` is Markdown SOURCE —
/// rendered to sanitized HTML at send/display time, never stored
/// pre-rendered (§12.1). `sentBy`/`targetId` are deliberately NOT relations:
/// a sent notification must outlive the sender/role it describes (same
/// rationale as AuditLog's actor columns).
model Notification {
  id           String                 @id @default(uuid()) @db.Uuid
  createdAt    DateTime               @default(now()) @map("created_at")
  category     String
  title        String
  bodyMarkdown String                 @map("body_markdown")
  /// null = system-generated (e.g. a password reset notice).
  sentBy       String?                @db.Uuid @map("sent_by")
  targetType   NotificationTargetType @map("target_type")
  /// user_id or role_id; null when targetType = 'all_users'.
  targetId     String?                @db.Uuid @map("target_id")

  recipients NotificationRecipient[]

  @@index([createdAt])
  @@index([category])
  @@map("notifications")
}

/// The in-app fan-out (§12.1): one row per targeted user per notification —
/// drives the bell icon / unread count. `emailedAt` records the moment the
/// email channel actually handed the rendered mail to the transport (null
/// for in-app-only categories or when the email failed).
model NotificationRecipient {
  notificationId String    @db.Uuid @map("notification_id")
  userId         String    @db.Uuid @map("user_id")
  readAt         DateTime? @map("read_at")
  emailedAt      DateTime? @map("emailed_at")

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("notification_recipients")
}

// --- Phase 5: Module registry menu entries -------------------------------
// See apps/api/src/core/migrations/0008_module_menu_entries.sql for the raw
// DDL this mirrors, and docs/MODULE_SPEC.md §2 ("menu") / §4 step 5.

/// One row per manifest `menu` entry (MODULE_SPEC.md §2), persisted at
/// install/upgrade time so the frontend can render the nav tree without
/// re-reading every module's manifest.json on every request. `id` is the
/// manifest entry's own globally-unique string id (e.g.
/// "library_catalog.root"), not a generated UUID. `parentId` is a plain
/// column, not a Prisma relation (self-referential FKs would force
/// parent-before-child insert ordering; cycle-freedom and resolution are
/// already guaranteed by the shared Zod schema's self-consistency checks
/// before any row is written — see packages/shared-types/src/module-manifest.ts).
model ModuleMenuEntry {
  id                 String  @id
  moduleKey          String  @map("module_key")
  labelI18nKey       String  @map("label_i18n_key")
  icon               String?
  parentId           String? @map("parent_id")
  order              Int
  route              String
  requiredPermission String  @map("required_permission")

  @@index([moduleKey])
  @@map("module_menu_entries")
}

/// Many-to-many: a user can hold multiple roles (ARCHITECTURE.md §7.1).
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}
