{
  "name": "@papp/api",
  "version": "0.0.1",
  "private": true,
  "description": "papp API — NestJS backend (core platform + dynamically installed modules).",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,prisma}/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.unit.config.ts",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.integration.config.ts",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config test/jest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@prisma/client": "^6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.1",
    "@nestjs/schematics": "^12.0.2",
    "@nestjs/testing": "^12.0.3",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.1.8",
    "jest": "^30.5.1",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
