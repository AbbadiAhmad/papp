{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "assets": [
      {
        "include": "core/migrations/**/*.sql",
        "watchAssets": true
      },
      {
        "include": "core/i18n/locales/**/*.json",
        "watchAssets": true
      }
    ]
  }
}
