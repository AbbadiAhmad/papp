{
  "name": "papp",
  "version": "0.0.1",
  "private": true,
  "description": "papp — modular back-office platform. Base: user/role/permission management, audit logging, Arabic-first (RTL) multi-language UI. First real module: Library Management.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.1.8",
    "globals": "^17.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
